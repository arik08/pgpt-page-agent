# 이 파일을 .env 로 복사해서 고치세요. (.env는 git에 올라가지 않습니다)
# .env 값은 PC의 환경 변수보다 우선합니다. 이름 앞의 AGENT_ 는 다른 도구와 겹치지 않게 하려는 것입니다.

# auto: OPENAI_API_KEY가 있으면 openai, 없으면 codex(~/.codex/auth.json)
AGENT_PROVIDER=auto

# --- 실사용: OpenAI API ---
OPENAI_API_KEY=
AGENT_MODEL=gpt-6.1-luna
# 사내 게이트웨이 등 OpenAI 호환 주소를 쓸 때만 바꿉니다.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 집에서 테스트: Codex OAuth (ChatGPT 구독) ---
# ChatGPT 계정으로는 gpt-6.1-luna가 지원되지 않아 gpt-6-luna로 시험합니다.
AGENT_CODEX_MODEL=gpt-6-luna

# 추론 강도: low / medium / high  (비우면 보내지 않음)
AGENT_REASONING_EFFORT=low
# 웹 검색 도구: on / off
AGENT_WEB_SEARCH=on

# 서버 주소. 비우면 openai는 0.0.0.0(같은 망 공개), codex는 127.0.0.1(이 PC만)
AGENT_HOST=
AGENT_PORT=8787
# 북마클릿에 넣을 주소를 직접 정할 때 (예: http://10.20.30.40:8787). 비우면 자동.
AGENT_PUBLIC_URL=

# 페이지 본문을 모델에 넘기는 최대 글자 수
AGENT_MAX_PAGE_CHARS=60000
